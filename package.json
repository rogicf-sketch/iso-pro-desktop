{
  "name": "iso-pro-desktop",
  "description": "I.S.O PRO — aplicação desktop (Electron + Vite)",
  "author": "I.S.O PRO Gestão de Materiais",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "version": "0.1.121",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "npm run sync:rir-fonts && node scripts/free-dev-port.mjs && concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-clean-start.ps1",
    "dev:web": "vite",
    "dev:browser": "cross-env VITE_OPEN_BROWSER=1 vite",
    "dev:electron": "wait-on -t 120000 http-get://127.0.0.1:5173/ && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/run-electron-dev.mjs",
    "open:app": "start http://127.0.0.1:5173/#/login",
    "focus": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/focus-janela-iso-pro.ps1",
    "build": "tsc -b && vite build",
    "build:web": "npm run sync:rir-fonts && npm run build:logo-print && tsc -b && vite build",
    "build:hosting": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:icon": "node scripts/build-icon.mjs && node scripts/sync-rir-pdf-fonts.mjs && node scripts/render-logo-print-png.mjs",
    "build:logo-print": "node scripts/render-logo-print-png.mjs",
    "sync:rir-fonts": "node --use-system-ca scripts/sync-rir-pdf-fonts.mjs",
    "build:pdf-worker": "node services/pdf-worker/build.mjs",
    "test:pdf-worker": "node scripts/test-pdf-worker.mjs",
    "pdf-worker:start": "node services/pdf-worker/dist/index.mjs",
    "pdf-worker:run": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-pdf-worker.ps1",
    "deploy:pdf-supabase": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-pdf-supabase.ps1",
    "deploy:pdf-worker": "node scripts/deploy-pdf-worker.mjs",
    "build:app": "npm run build:web && npm run build:electron",
    "start:electron": "cross-env electron .",
    "pack": "npm run build:app && npm run build:icon && electron-builder",
    "dist:win": "npm run build:app && npm run build:icon && electron-builder --win && node scripts/verify-release.mjs",
    "dist:win:off-path": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-win-off-path.ps1",
    "sync:shared": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/sync-iso-pro-shared-all.ps1",
    "release:win-and-web": "npm run dist:win && cross-env DEPLOY_SKIP_BUILD=1 npm run deploy:web",
    "dist:win:portable": "npm run build:app && npm run build:icon && cross-env ELECTRON_BUILDER_CACHE=C:/eb-cache electron-builder --win portable && node scripts/verify-release.mjs",
    "dist:win:signed": "npm run build:app && npm run build:icon && electron-builder --win --config.win.signAndEditExecutable=true && node scripts/verify-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:load:atendimento": "node scripts/load-test-atendimento-comandos.mjs",
    "test:load:atendimento:hotspot": "node scripts/load-test-atendimento-hotspot.mjs",
    "test:load:atendimento:canteiro": "node scripts/load-test-atendimento-canteiro.mjs",
    "audit:atendimento:integridade": "tsx scripts/audit-atendimento-integridade.mjs",
    "docs:checklist-jwt-pdf": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/gerar-checklist-jwt-pdf.ps1",
    "docs:checklist-jwt-open": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/gerar-checklist-jwt-pdf.ps1 -AbrirHtml",
    "jwt:ativar-servidor": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ativar-jwt-servidor.ps1",
    "jwt:ativar-piloto": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ativar-jwt-servidor.ps1 -AutoPiloto",
    "jwt:validar-piloto": "node scripts/validar-piloto-jwt.mjs",
    "jwt:auditar-link": "node scripts/auditar-auth-link.mjs",
    "jwt:ativar-mfa-piloto": "node scripts/ativar-mfa-piloto.mjs",
    "jwt:abrir-secret-dashboard": "powershell -NoProfile -ExecutionPolicy Bypass -File ./release/abrir-secret-jwt-dashboard.ps1",
    "sentry:validate-dsn": "node scripts/validate-sentry-dsn.mjs",
    "sentry:ativar": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ativar-sentry-dsn.ps1",
    "sentry:smoke-test": "node scripts/sentry-smoke-test.mjs",
    "staging:link": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/link-staging.ps1",
    "ops:verificar-backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verificar-backup-supabase.ps1 -OpenDashboard",
    "ops:smoke-diario": "node scripts/smoke-diario-ops.mjs",
    "ops:prune-retencao": "node scripts/prune-retencao-ops.mjs",
    "ops:activar-secrets-smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/activar-secrets-smoke-github.ps1",
    "ops:abrir-dashboards": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/abrir-dashboards-nivel-mundial.ps1",
    "clean": "node scripts/clean.mjs",
    "check": "npm run typecheck && npm run test && npm run lint",
    "ci": "npm run typecheck && npm run test && npm run lint && npm run build:app && npm run build:icon && npm run audit:ci",
    "audit:ci": "node scripts/npm-audit-ci.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration:edge": "vitest run --config vitest.integration.config.ts",
    "preview": "vite preview",
    "license:keypair": "tsx scripts/generateDesktopLicenseKeyPair.ts",
    "license:generate": "tsx scripts/generateDesktopLicense.ts",
    "snapshot:export": "node --use-system-ca scripts/export-iso-pro-snapshot.mjs",
    "snapshot:verify": "node scripts/verify-iso-pro-snapshot-export.mjs",
    "backup:upload-oci": "node --use-system-ca scripts/upload-backup-to-oci-node.mjs",
    "backup:verify-bucket-private": "node --use-system-ca scripts/verify-oci-bucket-private.mjs",
    "oci:setup-windows": "node scripts/gerar-oci-config-windows.mjs",
    "deploy:web": "node scripts/deploy-web.mjs",
    "deploy:nginx-security": "node scripts/deploy-nginx-security.mjs",
    "restore:https-oracle": "node scripts/restore-https-oracle.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/react": "^9.22.0",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-query": "^5.99.0",
    "iso-pro-shared": "file:packages/iso-pro-shared",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.1",
    "nodemailer": "^8.0.7",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "supabase": "^2.102.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.7",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  }
}
