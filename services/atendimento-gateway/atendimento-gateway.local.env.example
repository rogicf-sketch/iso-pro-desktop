# Copiar para atendimento-gateway.local.env (gitignored) na mesma pasta.
# Pode reutilizar SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY do pdf-worker.local.env.

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: validar JWT do browser (recomendado em cutover JWT)
SUPABASE_ANON_KEY=
PORT=8791
ALLOWED_ORIGINS=https://isoprogestaodemateriais.com.br,https://www.isoprogestaodemateriais.com.br
# Timeout da chamada RPC à nuvem (ms)
RPC_TIMEOUT_MS=12000
