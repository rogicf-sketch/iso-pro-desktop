# Staging — I.S.O PRO (NÃO usar em builds de campo / produção)
# Copiar para `.env.staging` e preencher com o projecto Supabase de staging.
# Produção continua em `.env` / deploy-web.env.

VITE_SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcional
VITE_SENTRY_DSN=
VITE_ISO_PRO_JWT_AUTH=true

# E2E contra staging
# ISO_PRO_E2E_LOGIN=
# ISO_PRO_E2E_SENHA=
# ISO_PRO_E2E_TENANT_ID=00000000-0000-0000-0000-000000000001
